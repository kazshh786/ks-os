{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test tests/**/*.test.ts",
    "lint": "echo 'api lint passed'",
    "knowledge:import": "node --env-file-if-exists=../../.env --import tsx src/cli/import-knowledge-pack.ts",
    "knowledge:seed-actor:dev": "node --env-file-if-exists=../../.env --import tsx src/cli/seed-knowledge-development-actor.ts",
    "knowledge:verify-active": "node --env-file-if-exists=../../.env --import tsx src/cli/verify-active-knowledge-pack.ts",
    "knowledge:import:dev": "node --env-file-if-exists=../../.env --env-file=../../.env.development.local --import tsx src/cli/import-knowledge-pack.ts",
    "knowledge:seed-actor:dev-project": "node --env-file-if-exists=../../.env --env-file=../../.env.development.local --import tsx src/cli/seed-knowledge-development-actor.ts",
    "knowledge:verify-active:dev": "node --env-file-if-exists=../../.env --env-file=../../.env.development.local --import tsx src/cli/verify-active-knowledge-pack.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/formbody": "^8.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/sensible": "^6.0.4",
    "@ks-os/auth": "workspace:*",
    "@ks-os/contracts": "workspace:*",
    "@ks-os/database": "workspace:*",
    "@ks-os/email": "workspace:*",
    "@ks-os/fact-finding": "workspace:*",
    "@ks-os/notifications": "workspace:*",
    "@ks-os/site-blueprints": "workspace:*",
    "@ks-os/site-generation": "workspace:*",
    "@ks-os/site-jobs": "workspace:*",
    "@ks-os/site-knowledge": "workspace:*",
    "@ks-os/site-quality": "workspace:*",
    "@ks-os/site-publishing": "workspace:*",
    "@ks-os/site-review": "workspace:*",
    "@ks-os/site-schema": "workspace:*",
    "@ks-os/template-intelligence": "workspace:*",
    "@ks-os/workspace-provisioning": "workspace:*",
    "@supabase/supabase-js": "^2.110.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^5.0.0",
    "libphonenumber-js": "1.12.29",
    "resend": "^6.17.2",
    "stripe": "^22.3.2",
    "svix": "^1.21.0",
    "twilio": "5.10.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ks-os/config": "workspace:*",
    "@types/node": "^22.10.1",
    "@types/sinon": "^22.0.0",
    "sinon": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
