[Unit]
Description=KS OS shared multi-tenant website renderer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ksdeploy
Group=ksdeploy
WorkingDirectory=/srv/ks-os
EnvironmentFile=/srv/ks-os/.env
EnvironmentFile=-/run/ks-os/release.env
Environment=NODE_ENV=production
Environment=PATH=/home/ksdeploy/.nvm/versions/node/v24.18.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=HOST=127.0.0.1
Environment=PORT=5001
Environment=TRUST_PROXY=true
ExecStart=/home/ksdeploy/.nvm/versions/node/v24.18.0/bin/node /srv/ks-os/apps/sites/dist/server/entry.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
