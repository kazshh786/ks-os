[Unit]
Description=KS OS communications and lifecycle worker
After=network-online.target ks-os-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=ksdeploy
Group=ksdeploy
WorkingDirectory=/srv/ks-os
EnvironmentFile=/srv/ks-os/.env
ExecStart=/home/ksdeploy/.nvm/versions/node/v24.18.0/bin/node --env-file-if-exists=.env scripts/workers/run-communications-cycle.mjs
PrivateTmp=true
NoNewPrivileges=true
