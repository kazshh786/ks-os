# Fastify API Server Settings
PORT=5000
NODE_ENV=development
RELEASE_VERSION=development
LOG_LEVEL=info
TRUST_PROXY=false

# Development Authentication Guard Setup
# WARNING: Set to true ONLY for local development bypass. Must NEVER be set to true in production.
DEV_AUTH_ENABLED=false

# Supabase Public Client Credentials (Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_PASSWORD_RESET_ORIGIN=http://localhost:3000
VITE_ENABLE_MOCK_DATA=false

# Supabase Server Credentials (Backend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SECRET_KEY=backend-only-sb-secret-key
# Legacy fallback only. Prefer SUPABASE_SECRET_KEY for new Supabase API keys.
SUPABASE_SERVICE_ROLE_KEY=
TEAM_INVITE_REDIRECT_URL=http://localhost:3000/auth/invite
TENANT_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback
AGENCY_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback
TENANT_PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/callback
AGENCY_PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/callback
CUSTOMER_PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/customer/auth/callback
TENANT_SESSION_HARD_TTL_HOURS=24
CUSTOMER_SESSION_HARD_TTL_HOURS=720
AUDIT_IP_HASH_SECRET=generate-a-random-secret-at-least-32-characters

# Development auth seeding only. Choose locally; never commit a real password.
KS_OS_DEV_AUTH_PASSWORD=

# PostgreSQL Connection String (used by Drizzle ORM)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:6543/postgres

# Allowed Frontend Origin
FRONTEND_ORIGIN=http://localhost:3000
PRIVACY_WORKER_SECRET=generate-a-private-worker-secret-at-least-32-characters

# Vercel Project Integration (Staging & Production Domain Routing)
VERCEL_AUTH_TOKEN=your_vercel_api_token
VERCEL_PROJECT_ID=prj_vVxi53tF9BkyBeb7iYYiBdy6UW2B
VERCEL_TEAM_ID=team_KvtNAa8QG2pV8ZpwanQG6wkt

# Cloudflare CNAME DNS Configuration (Staging & Production)
CLOUDFLARE_API_TOKEN=your_cloudflare_dns_edit_token
CLOUDFLARE_ZONE_ID=your_cloudflare_domain_zone_id

# Stripe Payment Integrations (Phase 5.2 Stripe Connect, Phase 5.4A Refunds, and Webhooks are finalized/in-progress)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_...
STRIPE_PAYMENTS_WEBHOOK_SECRET=whsec_payments_...
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/api/stripe/return
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/api/stripe/refresh
STRIPE_DEFAULT_CONNECTED_ACCOUNT_COUNTRY=GB
BOOKING_PAYMENT_HOLD_MINUTES=30
STRIPE_APPLICATION_FEE_BPS=0
STRIPE_APPLICATION_FEE_FIXED=0

# Security Tokens and Salts
KS_OS_SERVICE_TOKEN=generate-a-long-random-service-token
BOOKING_RATE_LIMIT_SALT=generate-another-random-secret-at-least-32-characters
BOOKING_SLOT_HOLD_MINUTES=10
FORM_ASSIGNMENT_EXPIRY_DAYS=30
FORM_DRAFT_EXPIRY_DAYS=30
FORM_UPLOAD_BUCKET=form-uploads
FORM_UPLOAD_MAX_BYTES=10485760
FORM_UPLOAD_SCAN_WEBHOOK=
CUSTOMER_CLAIM_EXPIRY_DAYS=7

# Operational Outbox & Automation Integrations
AUTOMATION_EVENT_SECRET=generate-a-shared-secret-at-least-32-characters
AUTOMATION_EVENT_INGEST_URL=https://dashboard.kasimshah.com/api/automations/events
AUTOMATION_OUTBOX_WORKER_SECRET=generate-a-worker-secret-at-least-32-characters
AUTOMATION_WORKER_SECRET=generate-an-automation-worker-secret-at-least-32-characters
OPERATIONS_WORKER_SECRET=generate-an-operations-worker-secret-at-least-32-characters
CRON_SECRET=generate-a-vercel-cron-secret-at-least-32-characters

# External Reviews / Reputation (Phase 10.6; backend only)
INTEGRATION_ENCRYPTION_KEY=generate-32-random-bytes-as-base64-or-64-hex-characters
REVIEW_INVITATION_TOKEN_SECRET=generate-a-random-secret-at-least-32-characters
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=your-approved-google-oauth-client-id
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI=https://api.example.com/api/v1/reputation/connections/google/oauth/callback

# Resend Email Integration (Phase 6.2 Transactional Email)
RESEND_API_KEY=re_123456789...
RESEND_WEBHOOK_SECRET=whsec_resend_...
EMAIL_FROM_DOMAIN=notifications.ksos.com
EMAIL_AUTH_FROM=auth@notifications.ksos.com
EMAIL_BOOKINGS_FROM=bookings@notifications.ksos.com
EMAIL_PAYMENTS_FROM=payments@notifications.ksos.com
EMAIL_FORMS_FROM=forms@notifications.ksos.com
EMAIL_SUPPORT_REPLY_TO=support@ksos.com
EMAIL_OUTBOX_WORKER_SECRET=generate-a-long-random-worker-secret

# Phase 6.3 platform-owned Twilio SMS (backend only; never use VITE_)
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_webhook_validation_token
TWILIO_API_KEY_SID=SK_your_api_key_sid
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_MESSAGING_SERVICE_SID=MG_your_messaging_service_sid
TWILIO_STATUS_CALLBACK_URL=https://api.example.com/api/v1/webhooks/twilio/status
TWILIO_INBOUND_WEBHOOK_URL=https://api.example.com/api/v1/webhooks/twilio/inbound
SMS_DEFAULT_COUNTRY=GB
SMS_MAX_ATTEMPTS=5
SMS_DEFAULT_VALIDITY_SECONDS=3600
SMS_DAILY_SPEND_LIMIT_MINOR=
SMS_WORKER_SECRET=generate-a-worker-secret-at-least-32-characters
PUBLIC_APP_ORIGIN=https://app.example.com

# Phase 15.5 public multi-tenant website renderer (server-only)
PUBLIC_SITES_FALLBACK_DOMAIN=sites.kasimshah.com
PUBLIC_SITES_PREVIEW_HOST=preview.sites.kasimshah.com
PUBLIC_BOOKING_ORIGIN=https://book.example.com
SITE_PREVIEW_TOKEN_SECRET=generate-a-distinct-preview-signing-secret-at-least-32-characters
PUBLIC_SITES_PREVIEW_ORIGIN=https://preview.sites.kasimshah.com
SITE_REVIEW_INVITATION_SECRET=generate-a-distinct-site-review-invitation-secret-at-least-32-characters
FACT_FINDING_INVITATION_SECRET=generate-a-distinct-fact-finding-invitation-secret-at-least-32-characters
FACT_FINDING_CLIENT_ORIGIN=https://app.example.com/fact-finding
FACT_FINDING_STORAGE_BUCKET=private-fact-finding

# Phase 15.6A site worker (server-only)
SITE_WORKER_ID=
SITE_WORKER_CONCURRENCY=2
SITE_WORKER_POLL_INTERVAL_MS=1000
SITE_WORKER_LEASE_SECONDS=120
SITE_WORKER_HEARTBEAT_SECONDS=30
SITE_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
SITE_WORKER_HEALTH_HOST=127.0.0.1
SITE_WORKER_HEALTH_PORT=8091
SITE_WORKER_LOG_LEVEL=info
SITE_WORKER_ENABLE_TEST_HANDLERS=false

# Phase 15.8 quality gates (site worker only).
# Browser audits use the exact-version preview route with a bearer token signed
# by SITE_PREVIEW_TOKEN_SECRET. Keep AI review disabled until a governed
# provider is deliberately implemented; the current runtime fails closed.
SITE_QUALITY_ENABLED=false
SITE_QUALITY_BROWSER_ENABLED=false
SITE_QUALITY_BROWSER_CONCURRENCY=2
SITE_QUALITY_PAGE_TIMEOUT_MS=30000
SITE_QUALITY_RUN_TIMEOUT_MS=900000
SITE_QUALITY_PREVIEW_ORIGIN=https://preview.sites.kasimshah.com
SITE_QUALITY_AI_ENABLED=false

# Phase 15.6B knowledge import (server-only, local development by default)
KNOWLEDGE_IMPORT_ALLOW_REMOTE_DEVELOPMENT=false
KNOWLEDGE_IMPORT_ALLOWED_PROJECT_REF=
MIGRATION_ALLOW_REMOTE_DEVELOPMENT=false
MIGRATION_ALLOWED_PROJECT_REF=

# Phase 15.6C structured site generation (server/worker only).
# Keep disabled until the worker is started with the controlled generation
# executor. Never expose SITE_AI_API_KEY through VITE_ variables.
SITE_AI_GENERATION_ENABLED=false
SITE_AI_PROVIDER=gemini
SITE_AI_MODEL=
SITE_AI_API_KEY=
SITE_AI_REQUEST_TIMEOUT_MS=60000
SITE_AI_MAX_REPAIR_ATTEMPTS=2
SITE_AI_MAX_OUTPUT_CHARACTERS=250000
SITE_AI_MAX_CONCURRENT_REQUESTS=2
SITE_AI_TEMPERATURE=0.2
SITE_AI_GENERATOR_VERSION=1.0.0

# Phase 13 integrations (server-only credentials; use separate values per environment)
INTEGRATION_ENCRYPTION_KEY=generate-32-random-bytes-as-base64-or-64-hex-characters
INTEGRATION_WORKER_SECRET=generate-a-worker-secret-at-least-32-characters
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://api.example.com/api/v1/integrations/oauth/google/callback
MICROSOFT_CALENDAR_CLIENT_ID=your-microsoft-application-id
MICROSOFT_CALENDAR_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALENDAR_REDIRECT_URI=https://api.example.com/api/v1/integrations/oauth/microsoft/callback
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=https://api.example.com/api/v1/integrations/oauth/xero/callback
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_REDIRECT_URI=https://api.example.com/api/v1/integrations/oauth/quickbooks/callback
PUBLIC_API_ENABLED=true
WIDGET_PUBLIC_URL=https://book.example.com
WIDGET_ALLOWED_ORIGINS=https://www.example.com
STRIPE_TERMINAL_ENABLED=false
