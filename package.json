{
  "name": "ks-os-platform",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --filter \"*\" --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter \"*\" build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "typecheck": "pnpm --filter \"*\" typecheck",
    "lint": "pnpm --filter \"*\" lint",
    "test": "pnpm --filter \"*\" test",
    "verify": "pnpm --filter \"*\" verify",
    "db:migrations:status": "node --env-file=.env scripts/database/migrate.mjs --status",
    "db:migrations:plan": "node --env-file=.env scripts/database/migrate.mjs --plan",
    "db:migrations:apply": "node --env-file=.env scripts/database/migrate.mjs --apply",
    "db:reconcile:report": "node --env-file=.env scripts/database/reconcile.mjs",
    "db:reconcile:apply": "node --env-file=.env scripts/database/reconcile-apply.mjs",
    "deploy:preflight": "node --env-file=.env scripts/deploy/preflight.mjs",
    "deploy:verify": "pnpm test",
    "deploy:vps:dry-run": "bash scripts/deploy/deploy-vps.sh --dry-run",
    "seed:auth:dev": "pnpm --filter api exec tsx ../../scripts/seed-auth-development.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0"
  }
}
