{
  "name": "@ks-os/notifications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./sms": {
      "import": "./dist/sms/index.js",
      "types": "./src/sms/index.ts",
      "default": "./dist/sms/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@ks-os/config": "workspace:*",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
