{
  "name": "@ks-os/live-site-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/drizzle-data-source.d.ts",
      "import": "./dist/drizzle-data-source.js",
      "require": "./dist/drizzle-data-source.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ks-os/contracts": "workspace:*",
    "@ks-os/database": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ks-os/config": "workspace:*",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  }
}
